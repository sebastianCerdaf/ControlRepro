{
  "name": "controlrepro",
  "version": "1.0.0",
  "description": "ControlRepro - Sistema de gestión inteligente para reposición de productos en PYMEs",
  "author": "Sebastián Cerda Fuentes",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder -mwl"
  },
  "dependencies": {
    "better-sqlite3": "^9.0.0",
    "electron": "^30.0.0",
    "vue": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.controlrepro.app",
    "productName": "ControlRepro",
    "files": [
      "**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/.*",
      "!**/node_modules/.bin",
      "!src/test",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ControlRepro-mac-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ControlRepro-win-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
